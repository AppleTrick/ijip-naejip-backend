<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.home.ai.mapper.AIReportMapper">

    <resultMap id="AIReportResultMap" type="com.ssafy.home.ai.dto.AIReport">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="query" column="query"/>
        <result property="markdownContent" column="markdown_content"/>
        <result property="resultCount" column="result_count"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 보고서 저장 -->
    <insert id="insertReport" parameterType="com.ssafy.home.ai.dto.AIReport"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_reports (user_id, title, query, markdown_content, result_count)
        VALUES (#{userId}, #{title}, #{query}, #{markdownContent}, #{resultCount})
    </insert>

    <!-- 사용자별 보고서 목록 조회 (최신순) -->
    <select id="findByUserId" resultMap="AIReportResultMap">
        SELECT
            id,
            user_id,
            title,
            query,
            markdown_content,
            result_count,
            created_at
        FROM ai_reports
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- 보고서 상세 조회 -->
    <select id="findById" resultMap="AIReportResultMap">
        SELECT
            id,
            user_id,
            title,
            query,
            markdown_content,
            result_count,
            created_at
        FROM ai_reports
        WHERE id = #{id}
    </select>

    <!-- 보고서 삭제 -->
    <delete id="deleteById">
        DELETE FROM ai_reports
        WHERE id = #{id}
    </delete>

    <!-- 사용자의 보고서인지 확인 -->
    <select id="existsByIdAndUserId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM ai_reports
        WHERE id = #{id} AND user_id = #{userId}
    </select>

</mapper>

